# Networks this deployment accepts, comma separated. First is the default.
# Both can be live at once: the 402 advertises one accepts entry per network
# and the payer picks the chain.
MONAD_NETWORKS=testnet,mainnet
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org

# Where bonds are paid. Replace with your own wallet, or with the
# SubmissionRegistry escrow address once deployed. Optionally override
# per network (an escrow deployed on each chain has a different address).
PAY_TO_ADDRESS=
# PAY_TO_ADDRESS_TESTNET=
# PAY_TO_ADDRESS_MAINNET=

# Triage dashboard auth (Bearer token).
ADMIN_TOKEN=

PORT=3044
PUBLIC_URL=https://bounty402.jgsleepy.xyz

DEFAULT_BOND_USD=1
POC_MULTIPLIER=4

# --- demo hunter agent only (agent/hunter.ts). Never needed by the server. ---
HUNTER_PRIVATE_KEY=
# Per-payment ceiling for the demo agent (default 25).
HUNTER_MAX_USD=25

# Agent 2 (triager) wallet — sends refunds + awards. Needs USDC + MON.
TREASURY_PRIVATE_KEY=
TREASURY_ADDRESS=

# ── Circle developer-controlled wallets (optional) ──────────────────────────
# Lets an agent provision its own Monad wallet via POST /api/v1/wallets. With
# these unset the endpoint returns 501 and agents fall back to HUNTER_PRIVATE_KEY,
# so the demo never depends on a third-party signup.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
# Pin after the first run — the server logs the id it creates.
CIRCLE_WALLET_SET_ID=

# ── Ramp Network fiat onramp (optional) ─────────────────────────────────────
# Card / Apple Pay / bank -> USDC delivered on Monad mainnet (MONAD_USDC =
# 0x754704Bc059F8C67012fEd69BC8A327a5aafb603, same asset the 402 demands).
# The checkout link works without a key; set one for branding and analytics.
RAMP_HOST_API_KEY=

# ── Overseer gate ───────────────────────────────────────────────────────────
# 1 (default) = a human must approve before the treasury pays a refund or award.
# 0 = fully unattended, which is what the two-agent testnet demo runs.
OVERSEER_REQUIRED=1
APPROVAL_TIMEOUT_SEC=900

# ── Agent inference (which model drives agent/company.ts + agent/agent.ts) ────
# The agents are model-agnostic tool-callers (lib/llm.ts). Two providers:
#
#   1. Cheaper OpenAI-compatible gateway — set this and it takes priority:
CHEAPER_INFERENCE_API_KEY=
#      Endpoint of the gateway (OpenAI /chat/completions shape). CONFIRM this
#      matches your provider before running:
INFERENCE_BASE_URL=https://api.inference.net/v1
#
#   2. Anthropic direct — used only if CHEAPER_INFERENCE_API_KEY is unset:
# ANTHROPIC_API_KEY=
#
# REQUIRED to run either loop: the exact model id your provider serves. Left
# blank on purpose — the agents refuse to run until it is set, so nothing calls
# out by accident. Put the gateway's model id here when you're ready to demo,
# e.g. a strong tool-calling open model on the gateway, or claude-opus-5 on
# Anthropic. The scripted flows (scripts/*-flow.ts) never use this.
INFERENCE_MODEL=
